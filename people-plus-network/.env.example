# --- Public (safe to expose in the browser, used with the VITE_ prefix) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=People Plus Network
VITE_APP_URL=http://localhost:5173

# EmailJS is designed to be used client-side — the public key alone cannot
# send emails without a configured template, so it's safe here.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_WELCOME_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Private (server-side only — set these in Vercel's dashboard, never
# commit them, never prefix with VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
# PAYMENT_WEBHOOK_SECRET=   # add once you wire up a real payment gateway
